;
; OpenDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = OpenDriver.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
OpenDriver.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%OpenDriver.DeviceDesc% = OpenDriver_Device, Root\OpenDriver ; TODO: edit hw-id

[OpenDriver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
OpenDriver.sys

;-------------- Service installation
[OpenDriver_Device.NT.Services]
AddService = OpenDriver,%SPSVCINST_ASSOCSERVICE%, OpenDriver_Service_Inst

; -------------- OpenDriver driver install sections
[OpenDriver_Service_Inst]
DisplayName    = %OpenDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\OpenDriver.sys

[OpenDriver_Device.NT.Wdf]
KmdfService = OpenDriver, OpenDriver_wdfsect

[OpenDriver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "OpenDriver Installation Disk"
OpenDriver.DeviceDesc = "OpenDriver Device"
OpenDriver.SVCDESC = "OpenDriver Service"
